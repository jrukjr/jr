# MQTT Configuration
MQTT_BROKER=your-starlink-ip-or-domain
MQTT_PORT=1883
MQTT_USERNAME=draga
MQTT_PASSWORD=your-password
MQTT_USE_TLS=false

# Device Configuration
DEVICE_ID=draga-001
DEVICE_NAME=Draga Principal
LOCATION=Porto Santos

# Sensor Configuration
SAMPLE_RATE=1.0
ALARM_CHECK_INTERVAL=0.5

# Safety Limits
MAX_PRESSURE=12.0
MAX_TEMPERATURE=90.0
MIN_OIL_LEVEL=20.0
MIN_OIL_PRESSURE=2.0
MAX_SUCTION=-0.8

# GPIO Pins (Raspberry Pi)
PUMP_RELAY_PIN=17
ALARM_LED_PIN=27
STATUS_LED_PIN=22

# Serial/Modbus Configuration
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_SLAVE_ID=1
